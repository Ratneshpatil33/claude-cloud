{
  "name": "gpu-rgb-case-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion animation of a GPU being installed in an RGB PC case on an off-white background",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render GpuRgbCase out/gpu-rgb-case.mp4",
    "still": "remotion still GpuRgbCase out/still.png --frame=240",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
